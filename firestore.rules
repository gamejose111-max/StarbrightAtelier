rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * STARBRIGHT ATELIER SECURITY RULES
     * 
     * Core Philosophy: 
     * This ruleset enforces a strict user-ownership model for all customer-related data. 
     * Access is primarily governed by the user's authenticated UID matching the path 
     * and internal document fields.
     *
     * Data Structure: 
     * The database is organized into two primary segments:
     * 1. Public Catalog: The `/products` collection is globally readable.
     * 2. Private Customer Data: All sensitive entities (Profiles, Addresses, Carts, Orders, 
     *    and Preferences) are nested under `/customers/{customerId}`.
     *
     * Key Security Decisions:
     * - Authorization Independence: Every document in a user sub-collection includes 
     *   a denormalized `customerId` field. This allows rules to verify ownership 
     *   locally without expensive parent-document lookups (get() calls).
     * - Prototyping Flexibility: Rules strictly enforce WHO can access data, 
     *   but do NOT enforce the specific shape or data types of the content itself.
     * - Relational Integrity: On creation, rules force the `customerId` or `id` 
     *   fields within the data to match the authenticated user's UID and the path.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Verifies ownership and ensures the document exists for state-changing operations. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the root Customer Profile. Enforces self-creation and ownership.
     * @path /customers/{customerId}
     * @allow (create) if auth.uid == "user123" and data.id == "user123"
     * @deny (get) if auth.uid == "user123" but path is /customers/user456
     * @principle Pattern 4: Self-Creation and Pattern 1: Ownership.
     */
    match /customers/{customerId} {
      allow get, list: if isOwner(customerId);
      allow create: if isOwner(customerId) && request.resource.data.id == customerId;
      allow update: if isExistingOwner(customerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(customerId);

      /**
       * @description Rules for customer addresses.
       * @path /customers/{customerId}/addresses/{addressId}
       * @allow (list) if auth.uid == customerId
       * @principle Pattern 1: Ownership with denormalized field validation.
       */
      match /addresses/{addressId} {
        allow get, list: if isOwner(customerId);
        allow create: if isOwner(customerId) && request.resource.data.customerId == customerId;
        allow update: if isExistingOwner(customerId) && request.resource.data.customerId == resource.data.customerId;
        allow delete: if isExistingOwner(customerId);
      }

      /**
       * @description Rules for the shopping cart container.
       * @path /customers/{customerId}/shoppingCarts/{shoppingCartId}
       * @principle Pattern 1: Ownership.
       */
      match /shoppingCarts/{shoppingCartId} {
        allow get, list: if isOwner(customerId);
        allow create: if isOwner(customerId) && request.resource.data.customerId == customerId;
        allow update: if isExistingOwner(customerId) && request.resource.data.customerId == resource.data.customerId;
        allow delete: if isExistingOwner(customerId);

        /**
         * @description Rules for items within a cart. Uses denormalized customerId for security.
         * @path /customers/{customerId}/shoppingCarts/{shoppingCartId}/cartItems/{cartItemId}
         * @principle Pattern 1: Ownership via denormalized field to avoid get() on parent cart.
         */
        match /cartItems/{cartItemId} {
          allow get, list: if isOwner(customerId);
          allow create: if isOwner(customerId) && request.resource.data.cartId == shoppingCartId;
          allow update: if isExistingOwner(customerId) && request.resource.data.cartId == resource.data.cartId;
          allow delete: if isExistingOwner(customerId);
        }
      }

      /**
       * @description Rules for customer orders.
       * @path /customers/{customerId}/orders/{orderId}
       * @principle Pattern 1: Ownership.
       */
      match /orders/{orderId} {
        allow get, list: if isOwner(customerId);
        allow create: if isOwner(customerId) && request.resource.data.customerId == customerId;
        allow update: if isExistingOwner(customerId) && request.resource.data.customerId == resource.data.customerId;
        allow delete: if isExistingOwner(customerId);

        /**
         * @description Rules for specific items in an order.
         * @path /customers/{customerId}/orders/{orderId}/orderItems/{orderItemId}
         * @principle Pattern 1: Ownership via path and denormalized link.
         */
        match /orderItems/{orderItemId} {
          allow get, list: if isOwner(customerId);
          allow create: if isOwner(customerId) && request.resource.data.orderId == orderId;
          allow update: if isExistingOwner(customerId) && request.resource.data.orderId == resource.data.orderId;
          allow delete: if isExistingOwner(customerId);
        }
      }

      /**
       * @description Rules for AI-driven user preferences.
       * @path /customers/{customerId}/preferences/{preferenceId}
       * @principle Pattern 1: Ownership.
       */
      match /preferences/{preferenceId} {
        allow get, list: if isOwner(customerId);
        allow create: if isOwner(customerId) && request.resource.data.customerId == customerId;
        allow update: if isExistingOwner(customerId) && request.resource.data.customerId == resource.data.customerId;
        allow delete: if isExistingOwner(customerId);
      }
    }

    /**
     * @description Public product catalog.
     * @path /products/{productId}
     * @allow (get) if true (public access)
     * @deny (create) if true (writes restricted to non-client/admin roles)
     * @principle Pattern 5: Public Read / Restricted Write.
     */
    match /products/{productId} {
      allow get, list: if true;
      // CRITICAL: Cannot implement owner-only writes. The 'Product' entity is missing an 'ownerId' or 'authorId' field.
      allow create, update, delete: if false; // TODO: Add owner or admin validation once the schema is updated.
    }
  }
}