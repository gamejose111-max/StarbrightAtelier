
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ATELIÊ STARBRIGHT - REGRAS DE SEGURANÇA REFORÇADAS
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- CATÁLOGO DE PRODUTOS ---
    match /products/{productId} {
      // Público pode ver os produtos
      allow read: if true;
      // Admin pode criar, editar e excluir
      allow create, update, delete: if isSignedIn();
      // Garantir que a regra de escrita genérica também funcione
      allow write: if isSignedIn();
    }

    // --- GESTÃO DE PEDIDOS ---
    match /orders/{orderId} {
      // Público pode criar pedidos (checkout)
      allow create: if true;
      // Apenas admin logado pode gerir pedidos
      allow read, update, delete: if isSignedIn();
    }

    // --- DADOS DO CLIENTE ---
    match /customers/{customerId} {
      allow read, write: if isSignedIn() && request.auth.uid == customerId;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == customerId;
      }
    }
  }
}
