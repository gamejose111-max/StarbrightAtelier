rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ATELIÊ STARBRIGHT - REGRAS DE SEGURANÇA
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- CATÁLOGO DE PRODUTOS ---
    match /products/{productId} {
      // Público pode ver os produtos
      allow read: if true;
      // Apenas admin logado pode criar, editar ou excluir
      allow write: if isSignedIn();
    }

    // --- GESTÃO DE PEDIDOS ---
    match /orders/{orderId} {
      // Público pode criar pedidos (checkout)
      allow create: if true;
      // Apenas admin logado pode listar, ver detalhes e atualizar status
      allow read, update, delete: if isSignedIn();
    }

    // --- DADOS DO CLIENTE (BACKEND.JSON) ---
    match /customers/{customerId} {
      // O usuário só acessa seus próprios dados
      allow read, write: if isSignedIn() && request.auth.uid == customerId;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == customerId;
      }
    }
  }
}