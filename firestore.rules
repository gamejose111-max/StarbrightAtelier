rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * STARBRIGHT ATELIER SECURITY RULES
     * 
     * Core Philosophy: 
     * Enforces strict user-ownership for private data and administrative access for catalog management.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- TOP-LEVEL COLLECTIONS ---

    /**
     * @description Public product catalog. Admin management.
     */
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    /**
     * @description Orders management. Allows public creation (checkout) and admin management.
     */
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // --- NESTED CUSTOMER DATA (As defined in backend.json) ---

    match /customers/{customerId} {
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow read, write: if isOwner(customerId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(customerId);
      }
    }
  }
}