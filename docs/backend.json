
{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A purchase order from a customer.",
      "type": "object",
      "properties": {
        "customerEmail": { "type": "string", "format": "email" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "zipCode": { "type": "string" },
        "address": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "number": { "type": "string" },
        "residenceType": { "type": "string", "enum": ["Casa", "Apartamento"] },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productPrice": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerEmail", "zipCode", "address", "number", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "A luxury handbag product in the catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isNew": { "type": "boolean" },
        "isOnPromotion": { "type": "boolean" },
        "promotionPrice": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "imageUrl"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer purchase orders"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of luxury products"
    }
  }
}
