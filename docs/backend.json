{
  "entities": {
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Peça de luxo do catálogo Starbright.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isNew": { "type": "boolean" },
        "isOnPromotion": { "type": "boolean" },
        "promotionPrice": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Pedido de compra realizado por um cliente.",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "cancelled"] },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catálogo público de produtos."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Pedidos realizados para análise do admin."
    }
  }
}